# Keep Cloudflare Pages from uploading non-web / internal files as static assets.
# Web assets stay served: *.html, *.json, *.webmanifest, functions/, assets/.
*.md
*.ps1
*.cmd
*.bak
*.bak_*
*.txt
.wrangler/

*.py
pipeline-audit-*/

# Cloud-refresh pipeline: never upload the vendored scripts or the raw
# SharePoint xlsx pulls as static assets.
pipeline/
_src/
